from typing import TypeAlias

from ._errorhandler import MetricsInput

# The rows of the kernels. A pair of strings gives one row, and a batch gives a list with one row for each pair.
SummaryRow: TypeAlias = tuple[float, int, int, int, int, int, list[str], list[str], list[tuple[str, str]]]
CountsRow: TypeAlias = tuple[float, float, float, float, float, float]
RateRow: TypeAlias = tuple[float, float, float]

def calculations(reference: str, hypothesis: str) -> SummaryRow: ...
def metrics(reference: MetricsInput, hypothesis: MetricsInput) -> SummaryRow | list[SummaryRow]: ...
def calculations_fast(reference: str, hypothesis: str) -> CountsRow: ...
def metrics_fast(reference: MetricsInput, hypothesis: MetricsInput) -> CountsRow | list[CountsRow]: ...
def calculations_wer_only(reference: str, hypothesis: str) -> RateRow: ...
def metrics_wer_only(reference: MetricsInput, hypothesis: MetricsInput) -> RateRow | list[RateRow]: ...
def table_budget(table: int = -1, codes: int = -1) -> tuple[int, int]: ...
